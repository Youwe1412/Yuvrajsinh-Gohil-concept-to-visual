{
  "_comment": "Aavkar Educational Motion Studio (AEM) client registry. Everything client-specific lives here; the aem CLI and the plugin hardcode no client. Paths may use ~. protected_files are relative to the client's design_system or to the active project folder. Add a client with: aem new-client <id>.",
  "version": 1,
  "operator": {
    "id": "yuvraj",
    "name": "Yuvraj"
  },
  "shared_paths": [
    "~/Documents/Aavkar Educational Motion Studio",
    "~/.aem",
    "~/.claude/skills",
    "~/.claude/plugins",
    "~/.claude/dev-mods",
    "~/Tools/fcp-edit-workflow",
    "~/Documents/Aavkar Cut Assist",
    "~/.npm-global/lib/node_modules/hyperframes",
    "~/.cache/hyperframes",
    "~/Library/Application Support/Claude/claude-code",
    "~/.codex/packages"
  ],
  "clients": [
    {
      "id": "joel",
      "name": "MergeToMaster",
      "contact": "Joel Belton",
      "design_system": "/Volumes/T7 Red/Yuvraj Folder/Freelance Work/Joel Belton - MergeToMaster/00 - MergeToMaster Design System",
      "projects_root": "/Volumes/T7 Red/Yuvraj Folder/Freelance Work/Joel Belton - MergeToMaster",
      "projects": {
        "P1": {
          "dir": "P1 - Frontend Design/Animations using Hyperframes/MergeToMaster",
          "note": "P1's HyperFrames project lives below the P1 folder."
        },
        "P2": {
          "dir": "P2 - Claude Code",
          "note": "P2's current cut is Videos and Media/RoughCut.mp4 (25/1, 3840x2160). No HyperFrames project yet."
        }
      },
      "decisions_file": "joel-decisions.md",
      "decisions_order": "newest_first",
      "decision_scopes": [
        "channel",
        "video",
        "instance"
      ],
      "rules_file": "rules.md",
      "preference_prefix": "J",
      "labelled_cases_file": "critic/labelled-cases.jsonl",
      "text_dirs": [
        "text"
      ],
      "skill": "mergetomaster-studio",
      "skill_master": "Skill/mergetomaster-studio",
      "rule_id_pattern": "\\b[A-Z]{1,2}(?:-T\\d)?-\\d{2}\\b",
      "gates": {
        "G1": "Inputs",
        "G2": "Plan",
        "G3": "Stills",
        "G4": "Rough render",
        "G5": "Critique and repair",
        "G6": "Deliver",
        "G7": "Joel's review"
      },
      "waiting_on_client_ids": [
        "joel"
      ],
      "protected_files": {
        "design_system": [
          "joel-decisions.md",
          "rules.md",
          "critic/labelled-cases.jsonl"
        ],
        "project": [
          "approvals.jsonl",
          "events.jsonl"
        ]
      },
      "blocked_commands": [
        "snapshot --describe"
      ],
      "approval_gates": {
        "command_patterns": [
          "\\bfcpxml\\b",
          "\\bplacement\\b",
          "\\bplace\\b",
          "\\bdeliver(?:y)?\\b",
          "Animations Done"
        ],
        "write_extensions": [
          ".fcpxml"
        ],
        "media_extensions": [
          ".mp4",
          ".mov",
          ".m4v",
          ".mxf"
        ]
      },
      "review_inbox": {
        "service": "Frame.io",
        "import": "csv",
        "note": "Export the review link's comments as CSV; aem import-review reads the header row and maps columns.",
        "plan_files": [
          "shotlist.md",
          "visual-plan.md"
        ],
        "stills_dirs": [
          "stills"
        ],
        "gates": {
          "plan_row": "G2",
          "still": "G3",
          "render": "G4"
        }
      },
      "audio": {
        "summary": "Joel's sound policy, read by the mergetomaster-studio skill and checked with earshot. aem does not read it. Each value names the rule it comes from.",
        "libraries": [
          {
            "name": "Epidemic Sound",
            "path": "~/Documents/Epidemic Sound"
          },
          {
            "name": "Envato Elements",
            "path": null
          }
        ],
        "libraries_first": true,
        "cue_kinds": [
          "mouse clicks",
          "keyboards",
          "anything else appropriate"
        ],
        "music": {
          "library": "Epidemic Sound",
          "vocals_under_speech": false,
          "beds_per_segment": 1
        },
        "loudness": {
          "master_lufs_integrated": -14,
          "true_peak_dbtp": -1,
          "dialogue_lufs_short_term": [
            -16,
            -14
          ],
          "music_under_dialogue_db": [
            18,
            22
          ]
        },
        "generated_sfx": "pending",
        "llm_upload": false,
        "sources": {
          "libraries": "M-25, E-09",
          "cue_kinds": "J-05",
          "music": "J-03, E-09",
          "loudness": "E-08",
          "generated_sfx": "open question in joel-decisions.md; J-01, B-26 apply if allowed",
          "llm_upload": "client material stays on this machine"
        }
      },
      "moments": {
        "plan_files": [
          "visual-plan.md"
        ],
        "shotlist_files": [
          "shotlist.md"
        ],
        "placement_files": [
          "data/edit.json",
          "renders/*/PLACEMENTS.csv"
        ],
        "note": "Moments come from the skill's own files: visual-plan.md and shotlist.md rows (first cell the moment, columns for word IDs, job, treatment, knows before, knows after, must stay true, where the picture stops being accurate, rule IDs); else the placements of P1's kind."
      },
      "stage_groups": {
        "design": [
          "G1",
          "G2",
          "G3"
        ],
        "build": [
          "G4"
        ],
        "review": [
          "G5",
          "G7"
        ],
        "placement": [
          "G6"
        ]
      },
      "evidence": {
        "rules": {
          "sync": [
            "M-03"
          ],
          "phone": [
            "B-T1-03"
          ],
          "flash": [
            "B-T1-01",
            "M-T1-01",
            "M-26"
          ],
          "motion": [
            "M-T1-03"
          ],
          "contract": [
            "M-18"
          ],
          "critic": [
            "M-19"
          ]
        },
        "max_per_command": 6
      },
      "review_profile": {
        "unit": "whole video",
        "approval_channel": "Frame.io",
        "notes_channel": "Frame.io",
        "other_channels": [
          "WhatsApp"
        ],
        "sees_process": false,
        "note_window_s": 1.0,
        "direction": {
          "P2": "none"
        },
        "summary": "Joel reviews the finished video, never individual animations. Approval, feedback and any timestamped instructions arrive on Frame.io; some feedback arrives on WhatsApp. He never sees the production process. How much he directs varies by video, and the absence of notes is itself a decision: on P1 he gave 66 timestamped notes; on P2 none, trusting the editor's judgment."
      },
      "idle_minutes": 10,
      "render_sentinel": {
        "command_patterns": [
          "(?:^|[\\s;&|/])bin/(?:r|ra|renderall)\\.sh\\b"
        ],
        "output_dirs": [
          "renders"
        ],
        "note": "P1 renders through bin/r.sh (full frame), bin/ra.sh (alpha .mov) and bin/renderall.sh; all write to renders/."
      }
    }
  ]
}
